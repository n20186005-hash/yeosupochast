---
import '../styles/global.css';
interface Props { title: string; description: string; image?: string; noindex?: boolean; }
const { title, description, image = '/images/yeosu-night.jpg', noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const socialImage = Astro.site ? new URL(image, Astro.site).href : image;
// SEO 사이트명 형식: 관광지명 + 도시 + 여행 가이드
const SITE_NAME = '여수 낭만포차거리 여수 — 여행 가이드';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071522" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {canonical && !noindex && <link rel="alternate" hreflang="ko" href={canonical} />}
    {canonical && !noindex && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <title>{title}</title>
    <script is:inline src="/consent.js" defer></script>
  </head>
  <body>
    <a class="skip" href="#main">본문 바로가기</a>
    <slot />
  </body>
</html>
