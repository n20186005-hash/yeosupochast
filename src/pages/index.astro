---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = Astro.site?.href?.replace(/\/$/, '');
const mapUrl = 'https://www.google.com/maps?q=34.7364135,127.7493336&output=embed&hl=ko';
const googleMapUrl = 'https://www.google.com/maps/search/?api=1&query=34.7364135%2C127.7493336';
const naverMapUrl = 'https://map.naver.com/p/search/%EC%97%AC%EC%88%98%20%EB%82%AD%EB%A7%8C%ED%8F%AC%EC%B0%A8%EA%B1%B0%EB%A6%AC';

const attraction = {
  '@type': 'TouristAttraction',
  '@id': siteUrl ? `${siteUrl}/#attraction` : undefined,
  name: '여수밤바다 낭만포차거리',
  alternateName: '여수 낭만포차',
  description: '거북선대교 아래 여수 밤바다와 함께 지역 해산물 음식을 즐기는 야간 포장마차 거리.',
  url: siteUrl || undefined,
  hasMap: googleMapUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '하멜로 102',
    addressLocality: '여수시',
    addressRegion: '전라남도',
    addressCountry: 'KR'
  },
  geo: { '@type': 'GeoCoordinates', latitude: 34.7364135, longitude: 127.7493336 },

};

const faqs = [
 ['낭만포차거리 영업시간은 어떻게 확인하나요?', '2026년 10월 20일 확인한 여수관광문화는 동·하절기 모두 18:00–다음 날 01:00을 안내합니다. 한국관광공사 자료에는 겨울 17:00–24:00이라는 다른 값이 남아 있습니다. 포차별 주문·마감과 임시 휴무는 방문 전에 따로 확인하세요. 공공 보행공간의 통행시간과 음식점 영업시간은 같은 뜻이 아닙니다.'],
 ['첫째 수요일은 항상 휴무인가요?', '여수관광문화는 첫째 주 수요일 휴무에 연휴 및 4–6월·8–10월 예외를 명시합니다. 따라서 매월 같은 휴무를 적용하지 말고 방문일의 운영 공지를 확인하세요. 기상·운영 사정에 따른 휴무도 별개입니다.'],
 ['입장과 음식 비용은 같은가요?', '현재 거리 입장에 관한 별도 비용은 확인하지 않았습니다. 포차의 음식·음료, 추가 구성과 주차 금액은 각각 확인해야 하며, 이 가이드는 현재 메뉴나 가격표를 제공하지 않습니다.'],
 ['카드 결제가 가능한가요?', '여수관광문화는 카드 결제를 원칙으로 안내합니다. 각 포차에서 실제 가능한 결제수단과 주문 금액을 확인하세요.'],
 ['주차할 수 있나요?', '한국관광공사 자료는 주차 가능으로 안내합니다. 이것이 현재 빈자리·무료 주차·모든 차량 접근을 보장하지는 않습니다. 주차장 위치, 요금과 운영은 따로 확인하세요.'],
 ['휠체어나 유모차로 방문할 수 있나요?', '이 가이드는 모든 보행 구간과 포차 출입구를 직접 점검하지 않았습니다. 필요한 진입 경로·좌석·화장실과 지원 가능 여부를 방문 전에 운영기관과 확인하세요.'],
 ['비가 오거나 바람이 강해도 운영하나요?', '여수관광문화는 악천후와 기상특보 등에 따른 휴무 기준을 안내합니다. 옛 야경 사진이나 일반 시간표로 오늘의 영업·통행 가능성을 판단하지 말고 공지와 현장 안내를 확인하세요.'],
 ['얼마나 머무르면 좋나요?', '계획 예시로 식사 1–2시간을 잡고, 다른 장소를 추가하면 별도로 이동 여유를 둘 수 있습니다. 이 시간은 영업·입장 가능성을 확인한 일정이 아니며 실제 대기·귀가편에 맞춰 조정하세요.'],
 ['메뉴와 식이 제한은 어디에 물어보나요?', '실제 메뉴·원재료·조리 과정·추가 비용은 주문할 포차에 직접 확인하세요. 사진과 메뉴 이름만으로 성분이나 식이 제한 적합성을 판단하지 마세요. 이 가이드는 음식의 건강·안전성을 확인하지 않습니다.'],
 ['숙박이나 항공권을 예약할 수 있나요?', '이 사이트에는 예약·상품 판매·문의 폼이 없습니다. 숙박 주소와 늦은 귀가 경로, 체크인·취소 조건은 숙소와 교통 운영사에 직접 확인하세요. 항공·숙박 묶음상품도 이 사이트에서 판매하지 않습니다.']
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    attraction,
    {
      '@type': 'FAQPage',
      '@id': siteUrl ? `${siteUrl}/#faq` : undefined,
      mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
    }
  ]
};
---
<BaseLayout title="여수 낭만포차거리 영업시간·위치·휴무 | 하멜로 102" description="여수 낭만포차거리 하멜로 102 위치와 자료별 영업시간·휴무 차이, 포차별 주문·주차·귀가편 확인 사항을 정리한 독립 한국어 가이드입니다.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <header class="main-header fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#071522]/85 backdrop-blur-xl">
    <div class="site-header-inner container flex min-h-20 items-center justify-between gap-6">
      <a href="#top" class="shrink-0" aria-label="첫 화면으로 이동"><img src="/logo.svg" alt="여수 낭만포차거리 여수 — 여행 가이드" class="h-12 w-auto" /></a>
      <nav aria-label="주요 메뉴" class="main-nav flex items-center gap-5 text-sm font-bold text-slate-300">
        <a class="hover:text-white" href="#story">이야기</a><a class="hover:text-white" href="#visit">이용안내</a><a class="hover:text-white" href="#food">먹거리</a><a class="hover:text-white" href="#transport">교통</a><a class="hover:text-white" href="#stay">숙박·에어텔</a><a class="hover:text-white" href="#nearby">주변</a><a class="hover:text-white" href="#faq">자주 묻는 질문</a>
      </nav>
      <a href="#map" class="rounded-full border border-[#43d0d2]/40 bg-[#43d0d2]/10 px-4 py-2 text-sm font-extrabold text-[#8ff2ef]">지도 보기</a>
    </div>
  </header>

  <main id="main">
    <section id="top" class="relative min-h-[92vh] overflow-hidden pt-20">
      <img src="/images/yeosu-night.jpg" width="2400" height="1614" alt="밤에 불빛이 반사되는 여수 해안과 도시 야경" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,21,34,.96)_0%,rgba(7,21,34,.70)_48%,rgba(7,21,34,.28)_100%)]"></div>
      <div class="absolute inset-x-0 bottom-0 h-52 bg-gradient-to-t from-[#071522] to-transparent"></div>
      <div class="container relative flex min-h-[calc(92vh-80px)] items-end pb-20 pt-24">
        <div class="max-w-3xl">
          <span class="badge">여수시 하멜로 102 · 거북선대교 아래</span>
          <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-black text-[#8ff2ef]"><span>자료 확인: 2026년 10월 20일</span><span class="text-white/30">|</span><span>출처별 시간 차이 · 개별 포차 확인</span></p>
          <h1 class="mt-4 text-[clamp(2.5rem,6.2vw,5rem)] font-black leading-[.95] tracking-[-.05em]">여수 낭만포차거리<br/><span class="text-[#ff655b]">영업시간·주차·위치</span><br/>이용 가이드</h1>
          <p class="mt-5 text-sm font-black tracking-[.2em] text-[#ffd36a]">여수 밤바다의 식탁 · 낭만은 해가 진 뒤 시작됩니다</p>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-200">여수관광문화가 하멜로 102, 거북선대교 아래 18개 포차로 소개하는 야간 음식 거리입니다. 자료마다 다른 운영시간, 포차별 주문과 휴무, 귀가·주차 확인 사항을 나누어 안내합니다. 공공 길의 통행과 포차 영업을 같은 범위로 보지 않습니다.</p>
          <div class="mt-8 flex flex-wrap gap-3"><a href="#visit" class="rounded-full bg-[#ff655b] px-6 py-3 font-black text-[#071522]">방문 정보 먼저 보기</a><a href="#story" class="rounded-full border border-white/25 bg-white/5 px-6 py-3 font-bold">이곳의 이야기</a></div>
        </div>
      </div>
      <p class="hero-credit absolute bottom-3 right-4 z-10 text-xs text-white/75">2010년 여수 도시 야경 참고 사진; 현재 포차거리의 모습이 아닙니다. <a href="https://commons.wikimedia.org/wiki/File:Yeosu_by_night.jpg">thomas park · 출처</a> · <a href="https://creativecommons.org/licenses/by/2.0/">CC BY 2.0</a>. 크기·압축·화면 자르기 적용.</p>
    </section>

    <section class="pb-14">
      <div class="container grid gap-3 md:grid-cols-2 lg:grid-cols-4">
        <div class="card"><p class="text-xs font-black tracking-widest text-[#43d0d2]">주소</p><p class="mt-2 text-lg font-extrabold">전남 여수시 하멜로 102</p><p class="mt-1 text-sm text-slate-400">종화동 · 거북선대교 하부</p></div>
        <div class="card"><p class="text-xs font-black tracking-widest text-[#43d0d2]">운영</p><p class="mt-2 text-lg font-extrabold">시의 일반 운영 안내</p><p class="mt-1 text-sm text-slate-400">임시·개별 휴무와 출처 차이 확인</p></div>
        <div class="card"><p class="text-xs font-black tracking-widest text-[#43d0d2]">비용</p><p class="mt-2 text-lg font-extrabold">입장 관련 조건 별도 확인</p><p class="mt-1 text-sm text-slate-400">식음료는 개별 주문·결제</p></div>
        <div class="card"><p class="text-xs font-black tracking-widest text-[#43d0d2]">권장 체류</p><p class="mt-2 text-lg font-extrabold">식사 1~2시간</p><p class="mt-1 text-sm text-slate-400">해안 산책 포함 2~3시간 권장</p></div>
      </div>
    </section>

    <section id="story" class="section">
      <div class="container">
        <p class="section-kicker">도시의 밤이 된 포차</p><h2 class="section-title">바다를 바라보는 식탁에서<br/>여수의 야간 풍경으로</h2>
        <div class="grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:items-start">
          <div>
            <p class="lead">여수 낭만포차는 단순한 먹거리 골목보다 '밤바다를 경험하는 방식'에 가깝습니다. 여수관광문화는 2019년 10월 1일부터 거북선대교 하부공간 광장에 위치한다고 설명합니다. 현재 개별 포차의 영업과 주변 통행은 별도 확인해야 합니다.</p>
            <div class="mt-8 space-y-5">

              <div class="flex gap-5"><span class="mt-1 h-3 w-3 shrink-0 rounded-full bg-[#ff655b] shadow-[0_0_18px_#ff655b]"></span><div><strong class="text-xl">2019 · 이전</strong><p class="mt-1 text-slate-400">시 안내는 2019년 10월 1일부터 하멜로 102, 거북선대교 하부공간 광장에 위치한다고 설명합니다. 시 안내의 운영 규모는 18개소이며 오늘 모든 점포가 문을 열었다는 뜻은 아닙니다.</p></div></div>
              <div class="flex gap-5"><span class="mt-1 h-3 w-3 shrink-0 rounded-full bg-[#43d0d2] shadow-[0_0_18px_#43d0d2]"></span><div><strong class="text-xl">별도 주변 방문 계획</strong><p class="mt-1 text-slate-400">하멜전시관·하멜등대·종포해양공원 등은 별도 방문 후보입니다. 야간 이동 경로와 개방은 각각 확인하세요.</p></div></div>
            </div>
          </div>
          <figure class="overflow-hidden rounded-[28px] border border-white/10 bg-white/5">
            <img src="/images/hamel-lighthouse.jpg" width="2400" height="4265" alt="여수 해안의 빨간 하멜등대" class="aspect-[4/3] w-full object-cover" loading="lazy" />
            <figcaption class="p-4 text-xs leading-5 text-slate-400">2017년 하멜등대 참고 사진. 현재 접근·조명·통행을 보장하지 않습니다. <a href="https://commons.wikimedia.org/wiki/File:Hamel_lighthouse.jpg">Altostratus · 출처</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. 크기·압축·화면 자르기 적용.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section bg-[#091a27]">
      <div class="container grid gap-8 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
        <figure class="overflow-hidden rounded-[28px] border border-white/10"><img src="/images/hamel-memorial-hall.jpg" width="2400" height="1350" alt="여수 하멜전시관 건물" class="aspect-[4/3] w-full object-cover" loading="lazy"/><figcaption class="p-4 text-xs text-slate-400">2017년 전시관 참고 사진. 오늘의 개관·진입 가능성을 뜻하지 않습니다. <a href="https://commons.wikimedia.org/wiki/File:Hamel_memorial_hall.jpg">Altostratus · 출처</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. 크기·압축·화면 자르기 적용.</figcaption></figure>
        <div><p class="section-kicker">하멜의 이름이 남은 해안</p><h2 class="section-title">포차거리 옆에서 만나는<br/>별도 방문 후보 확인</h2><p class="lead">하멜전시관은 포차거리와 별도로 확인할 방문 후보입니다. 전시 내용, 현재 개관시간·휴관·입장과 이동 경로는 해당 운영기관의 안내를 확인하세요. 이 페이지의 옛 사진은 오늘의 입장 가능성을 보여주는 자료가 아닙니다.</p><p class="mt-5 text-sm text-slate-400">사진과 장소 이름만으로 현재 전시·운영·진입 동선을 판단하지 마세요.</p></div>
      </div>
    </section>

    <section id="visit" class="section">
      <div class="container">
        <p class="section-kicker">방문 전 핵심 정보</p><h2 class="section-title">운영시간보다 중요한 것은<br/>'변경 가능성'까지 아는 것</h2>
        <p class="mb-8 text-sm font-black text-[#8ff2ef]">2026년 10월 20일 확인 · 시 관광안내와 관광공사 자료의 차이 표시</p>
        <div class="grid gap-5 lg:grid-cols-3">
          <article class="card lg:col-span-2"><h3 class="text-2xl font-black">자료별 운영시간</h3><div class="mt-6 grid gap-4 sm:grid-cols-2"><div class="rounded-2xl bg-[#ff655b]/10 p-5"><p class="text-sm font-extrabold text-[#ff9e97]">여수관광문화 · 겨울·여름 동일</p><p class="mt-1 text-3xl font-black">18:00–01:00</p></div><div class="rounded-2xl bg-[#43d0d2]/10 p-5"><p class="text-sm font-extrabold text-[#8ff2ef]">관광공사 · 겨울 안내</p><p class="mt-1 text-3xl font-black">17:00–24:00</p></div></div><p class="mt-5 text-sm text-slate-400">두 자료의 겨울 시간이 다릅니다. 관광공사는 여름 18:00–01:00을 안내합니다. 2026년 10월 20일 Maps 목록도 요일별 18:00–다음 날 01:00을 표시했지만, 이 목록이 휴무 예외나 오늘 개별 포차 영업을 확인해 주는 것은 아닙니다. 시 공지와 방문할 포차를 다시 확인하세요. 공공 길의 통행시간표와 음식점 영업시간은 같은 뜻이 아닙니다.</p></article>
          <article class="card"><h3 class="text-2xl font-black">정기 휴무</h3><p class="mt-4 text-4xl font-black text-[#ffd36a]">첫째 수요일</p><p class="mt-3 text-sm text-slate-400">시 안내는 연휴와 4–6월·8–10월을 예외로 명시합니다. 모든 달에 일괄 적용하지 말고 해당 방문일의 운영 공지를 확인하세요.</p></article>
          <article class="card"><h3 class="text-xl font-black">결제</h3><p class="mt-3 text-slate-300">카드 결제를 기본 운영 기준으로 안내합니다. 현장 결제 수단은 개별 포차 상황을 확인하세요.</p></article>
          <article class="card"><h3 class="text-xl font-black">Maps 날짜별 기록</h3><p class="mt-3 text-3xl font-black">3.5 / 5 · 7,341개</p><p class="mt-2 text-sm text-slate-400"><a href="https://maps.app.goo.gl/yUMFWpsQHDT4Kw1X6">2026년 10월 20일 Maps 목록</a>의 평점·평가 수입니다. 이 사이트의 평가가 아니며 옛 평가나 사진을 현재 점포 목록으로 사용하지 않습니다.</p></article>
