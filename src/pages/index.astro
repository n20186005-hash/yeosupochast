---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = Astro.site?.href?.replace(/\/$/, '');
const mapUrl = 'https://www.google.com/maps/embed?pb=!1m5!3m3!1m2!1s0x356dd8deafafcef3%3A0xefcc1acf2eee95ea!2sYeosu%20romantic%20carriage%20street!5e1!3m2!1sko!2skr!4v1787535496524!5m2!1sko!2skr&hl=ko';

const attraction = {
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': siteUrl ? `${siteUrl}/#attraction` : undefined,
  name: '여수밤바다 낭만포차거리',
  alternateName: '여수 낭만포차',
  description: '거북선대교 아래 여수 밤바다와 함께 지역 해산물 음식을 즐기는 야간 포장마차 거리.',
  url: siteUrl || undefined,
  image: siteUrl ? `${siteUrl}/images/yeosu-night.jpg` : '/images/yeosu-night.jpg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '하멜로 102',
    addressLocality: '여수시',
    addressRegion: '전라남도',
    postalCode: '59746',
    addressCountry: 'KR'
  },
  geo: { '@type': 'GeoCoordinates', latitude: 34.7365852485, longitude: 127.7495170813 },
  telephone: '+82-61-659-4553',
  isAccessibleForFree: true,
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '3.5', bestRating: '5' },
  openingHours: ['3월~10월 18:00-01:00', '11월~2월 17:00-24:00'],
  publicAccess: true,
  smokingAllowed: false
};

const faqs = [
  ['낭만포차거리는 언제 운영하나요?', '여수 관광 안내 기준으로 3~10월은 18:00~다음 날 01:00, 11~2월은 17:00~24:00 운영 안내가 있습니다. 기상·행사·운영 사정에 따라 달라질 수 있으므로 방문 직전 여수시 공식 안내를 확인하세요.'],
  ['정기 휴무일이 있나요?', '공식 관광 안내에는 매월 첫째 수요일 정기 휴무가 안내되어 있으며, 공휴일이나 일부 성수기에는 예외가 있습니다. 악천후나 공공안전 사유로 임시 휴무가 생길 수도 있습니다.'],
  ['입장료가 있나요?', '공식 안내에 거리 자체의 별도 입장료는 안내되어 있지 않습니다. 포차에서 주문하는 음식과 음료는 각 점포 메뉴에 따라 개별 결제합니다.'],
  ['카드 결제가 가능한가요?', '여수시 관광 안내는 카드 결제를 기본 운영 기준으로 안내합니다. 다만 결제 수단은 현장 상황에 따라 달라질 수 있습니다.'],
  ['주차는 어디에 하나요?', '관광공사 공개 정보에는 주차 가능으로 안내됩니다. 해안가 도로는 혼잡할 수 있으므로 주변 공영주차장 등 공공 주차시설을 우선 확인하고, 불법·노상 주차는 피하는 편이 좋습니다.'],
  ['휠체어나 유모차로 방문할 수 있나요?', '한국관광공사 열린관광 정보에는 평탄한 접근, 장애인 주차구역, 의자형 테이블 이용 가능 정보가 있습니다. 인근 하멜전시관에는 장애인 화장실이 안내되어 있습니다.'],
  ['비가 오거나 바람이 강해도 운영하나요?', '바닷가 야외형 관광지라 강풍·호우·태풍 등 기상 상황에 따라 운영이 조정되거나 중단될 수 있습니다. 출발 전에 공식 채널과 기상 정보를 함께 확인하세요.'],
  ['얼마나 머무르면 좋나요?', '식사 중심이라면 약 1~2시간, 하멜등대·종포해양공원 등 주변 해안 산책을 함께하면 2~3시간 정도를 권장합니다. 이는 여행 동선 설계를 위한 일반적인 제안입니다.'],
  ['가장 좋은 방문 시간은 언제인가요?', '일몰 전후부터 밤바다 조명이 살아나는 초저녁이 이 거리의 분위기를 느끼기 좋습니다. 혼잡을 피하려면 주말 피크 시간보다 평일 또는 이른 저녁을 고려하세요.'],
  ['아이와 함께 가도 되나요?', '공공 보행공간과 식사 공간을 함께 이용할 수 있지만 저녁에는 혼잡하고 주류를 판매하는 포차가 많습니다. 보호자는 해안 난간, 차량 동선, 뜨거운 조리기구 주변에서 특히 주의하세요.']
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    attraction,
    {
      '@type': 'FAQPage',
      '@id': siteUrl ? `${siteUrl}/#faq` : undefined,
      mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
    }
  ]
};
---
<BaseLayout title="여수 낭만포차거리 안내 | 밤바다·교통·주차·이용정보" description="여수시 하멜로 102 낭만포차거리의 운영시간, 역사, 교통, 주차, 화장실, 주변 명소와 지역 음식 정보를 공공자료로 정리한 비영리 여행 안내입니다.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#071522]/85 backdrop-blur-xl">
    <div class="container flex min-h-20 items-center justify-between gap-6">
      <a href="#top" class="shrink-0" aria-label="첫 화면으로 이동"><img src="/logo.svg" alt="여수 낭만포차거리 안내" class="h-12 w-auto" /></a>
      <nav aria-label="주요 메뉴" class="hidden items-center gap-5 text-sm font-bold text-slate-300 lg:flex">
        <a class="hover:text-white" href="#story">이야기</a><a class="hover:text-white" href="#visit">이용안내</a><a class="hover:text-white" href="#food">먹거리</a><a class="hover:text-white" href="#transport">교통</a><a class="hover:text-white" href="#nearby">주변</a><a class="hover:text-white" href="#faq">자주 묻는 질문</a>
      </nav>
      <a href="#map" class="rounded-full border border-[#43d0d2]/40 bg-[#43d0d2]/10 px-4 py-2 text-sm font-extrabold text-[#8ff2ef]">지도 보기</a>
    </div>
  </header>

  <main id="main">
    <section id="top" class="relative min-h-[92vh] overflow-hidden pt-20">
      <img src="/images/yeosu-night.jpg" alt="밤에 불빛이 반사되는 여수 해안과 도시 야경" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,21,34,.96)_0%,rgba(7,21,34,.70)_48%,rgba(7,21,34,.28)_100%)]"></div>
      <div class="absolute inset-x-0 bottom-0 h-52 bg-gradient-to-t from-[#071522] to-transparent"></div>
      <p class="absolute bottom-3 right-4 z-10 text-[10px] text-white/55">배경 사진: thomas park, 위키미디어 공용, CC BY 2.0</p>
      <div class="container relative flex min-h-[calc(92vh-80px)] items-end pb-20 pt-24">
        <div class="max-w-3xl">
          <span class="badge">여수시 하멜로 102 · 거북선대교 아래</span>
          <p class="mt-6 text-sm font-black tracking-[.24em] text-[#ffd36a]">여수 밤바다의 식탁</p>
          <h1 class="mt-3 text-[clamp(3.2rem,9vw,7.6rem)] font-black leading-[.88] tracking-[-.075em]">낭만은<br/><span class="text-[#ff655b]">해가 진 뒤</span><br/>시작됩니다.</h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-200">거북선대교 아래 고정형 포차 18개소가 모여 있는 여수의 대표 야간 관광거리. 운영시간부터 교통·화장실·주차·주변 산책까지, 상업적 추천 없이 공공자료를 중심으로 정리했습니다.</p>
          <div class="mt-8 flex flex-wrap gap-3"><a href="#visit" class="rounded-full bg-[#ff655b] px-6 py-3 font-black text-[#071522]">방문 정보 먼저 보기</a><a href="#story" class="rounded-full border border-white/25 bg-white/5 px-6 py-3 font-bold">이곳의 이야기</a></div>
        </div>
      </div>
    </section>

    <section class="pb-14">
      <div class="container grid gap-3 md:grid-cols-2 lg:grid-cols-4">
        <div class="card"><p class="text-xs font-black tracking-widest text-[#43d0d2]">주소</p><p class="mt-2 text-lg font-extrabold">전남 여수시 하멜로 102</p><p class="mt-1 text-sm text-slate-400">종화동 · 거북선대교 하부</p></div>
        <div class="card"><p class="text-xs font-black tracking-widest text-[#43d0d2]">운영</p><p class="mt-2 text-lg font-extrabold">연중 운영 안내</p><p class="mt-1 text-sm text-slate-400">계절별 운영시간·정기휴무 확인</p></div>
        <div class="card"><p class="text-xs font-black tracking-widest text-[#43d0d2]">비용</p><p class="mt-2 text-lg font-extrabold">별도 입장료 안내 없음</p><p class="mt-1 text-sm text-slate-400">식음료는 개별 주문·결제</p></div>
        <div class="card"><p class="text-xs font-black tracking-widest text-[#43d0d2]">권장 체류</p><p class="mt-2 text-lg font-extrabold">식사 1~2시간</p><p class="mt-1 text-sm text-slate-400">해안 산책 포함 2~3시간 권장</p></div>
      </div>
    </section>

    <section id="story" class="section">
      <div class="container">
        <p class="section-kicker">도시의 밤이 된 포차</p><h2 class="section-title">바다를 바라보는 식탁에서<br/>여수의 야간 풍경으로</h2>
        <div class="grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:items-start">
          <div>
            <p class="lead">여수 낭만포차는 단순한 먹거리 골목보다 ‘밤바다를 경험하는 방식’에 가깝습니다. 여수시는 2016년 해양공원 일대에서 낭만포차를 시작했고, 2019년 10월 거북선대교 아래 현재 위치로 옮겨 해안 보행 동선과 함께 운영하고 있습니다.</p>
            <div class="mt-8 space-y-5">
              <div class="flex gap-5"><span class="mt-1 h-3 w-3 shrink-0 rounded-full bg-[#ffd36a] shadow-[0_0_18px_#ffd36a]"></span><div><strong class="text-xl">2016 · 시작</strong><p class="mt-1 text-slate-400">여수 밤바다 관광 콘텐츠의 하나로 해양공원 일대에서 운영을 시작했습니다.</p></div></div>
              <div class="flex gap-5"><span class="mt-1 h-3 w-3 shrink-0 rounded-full bg-[#ff655b] shadow-[0_0_18px_#ff655b]"></span><div><strong class="text-xl">2019 · 이전</strong><p class="mt-1 text-slate-400">해양공원에서 하멜로 102, 거북선대교 하부로 자리를 옮겼습니다. 현재는 고정형 컨테이너 포차 18개소가 운영되는 구조입니다.</p></div></div>
              <div class="flex gap-5"><span class="mt-1 h-3 w-3 shrink-0 rounded-full bg-[#43d0d2] shadow-[0_0_18px_#43d0d2]"></span><div><strong class="text-xl">지금 · 야간 해안 관광축</strong><p class="mt-1 text-slate-400">하멜전시관·하멜등대·종포해양공원과 이어져 식사 전후에 걷기 좋은 해안 야간 동선을 이룹니다.</p></div></div>
            </div>
          </div>
          <figure class="overflow-hidden rounded-[28px] border border-white/10 bg-white/5">
            <img src="/images/hamel-lighthouse.jpg" alt="여수 해안의 빨간 하멜등대" class="aspect-[4/3] w-full object-cover" loading="lazy" />
            <figcaption class="p-4 text-xs leading-5 text-slate-400">하멜등대는 낭만포차거리 주변 해안 산책의 대표적인 공공 경관 요소입니다. 사진: Altostratus, 위키미디어 공용, CC BY-SA 4.0.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section bg-[#091a27]">
      <div class="container grid gap-8 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
        <figure class="overflow-hidden rounded-[28px] border border-white/10"><img src="/images/hamel-memorial-hall.jpg" alt="여수 하멜전시관 건물" class="aspect-[4/3] w-full object-cover" loading="lazy"/><figcaption class="p-4 text-xs text-slate-400">인근 하멜전시관. 사진: Altostratus, 위키미디어 공용, CC BY-SA 4.0.</figcaption></figure>
        <div><p class="section-kicker">하멜의 이름이 남은 해안</p><h2 class="section-title">포차거리 옆에서 만나는<br/>17세기 항해사의 기억</h2><p class="lead">거리 이름의 ‘하멜로’는 네덜란드인 헨드릭 하멜의 조선 체류 기록과 연결되는 여수의 역사적 장소성을 떠올리게 합니다. 인근 하멜전시관은 이 이야기를 전시로 풀어내며, 밤의 먹거리 거리와 낮의 역사 탐방을 한 동선에서 연결할 수 있게 합니다.</p><p class="mt-5 text-sm text-slate-400">역사 서술은 전시·공공 관광자료 범위에서 요약했으며, 검증되지 않은 전설이나 각색된 이야기는 넣지 않았습니다.</p></div>
      </div>
    </section>

    <section id="visit" class="section">
      <div class="container">
        <p class="section-kicker">방문 전 핵심 정보</p><h2 class="section-title">운영시간보다 중요한 것은<br/>‘변경 가능성’까지 아는 것</h2>
        <div class="grid gap-5 lg:grid-cols-3">
          <article class="card lg:col-span-2"><h3 class="text-2xl font-black">계절별 운영시간</h3><div class="mt-6 grid gap-4 sm:grid-cols-2"><div class="rounded-2xl bg-[#ff655b]/10 p-5"><p class="text-sm font-extrabold text-[#ff9e97]">3월~10월</p><p class="mt-1 text-3xl font-black">18:00–01:00</p></div><div class="rounded-2xl bg-[#43d0d2]/10 p-5"><p class="text-sm font-extrabold text-[#8ff2ef]">11월~2월</p><p class="mt-1 text-3xl font-black">17:00–24:00</p></div></div><p class="mt-5 text-sm text-slate-400">여수관광문화 공개 안내 기준. 포차별 준비·마감 시각은 다를 수 있으며, 기상 및 운영 사정에 따라 변동될 수 있습니다.</p></article>
          <article class="card"><h3 class="text-2xl font-black">정기 휴무</h3><p class="mt-4 text-4xl font-black text-[#ffd36a]">첫째 수요일</p><p class="mt-3 text-sm text-slate-400">매월 첫째 수요일이 기본 휴무로 안내됩니다. 공휴일 및 일부 성수기에는 예외가 있어 방문 전 공식 공지를 확인하는 것이 안전합니다.</p></article>
          <article class="card"><h3 class="text-xl font-black">결제</h3><p class="mt-3 text-slate-300">카드 결제를 기본 운영 기준으로 안내합니다. 현장 결제 수단은 개별 포차 상황을 확인하세요.</p></article>
          <article class="card"><h3 class="text-xl font-black">공개 지도 평점</h3><p class="mt-3 text-3xl font-black">3.5 / 5</p><p class="mt-2 text-sm text-slate-400">공개 지도에 표시되는 값은 수시로 변동될 수 있습니다. 본 안내는 평점을 상업적 추천 기준으로 사용하지 않습니다.</p></article>
          <article class="card"><h3 class="text-xl font-black">날씨</h3><p class="mt-3 text-slate-300">해안의 강풍·호우·태풍 등으로 임시 운영 조정이 생길 수 있습니다. 바람이 강한 날은 체감온도가 낮아 겉옷이 유용합니다.</p></article>
        </div>
      </div>
    </section>

    <section id="food" class="section bg-[#091a27]">
      <div class="container">
        <p class="section-kicker">주변 먹거리 · 상업적 추천 없음</p><h2 class="section-title">가게 이름 대신<br/>여수의 맛을 고르는 기준</h2><p class="lead">특정 업체를 추천하지 않습니다. 메뉴판의 원산지·가격·알레르기 정보를 확인하고, 여러 지역 음식 유형을 비교해 선택하세요.</p>
        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <div class="card"><span class="text-3xl">🐙</span><h3 class="mt-4 text-xl font-black">돌문어·해물삼합류</h3><p class="mt-2 text-sm text-slate-400">문어와 해산물, 고기·채소 등을 철판에 함께 익히는 여수 야간 포차의 대표적인 조합형 메뉴.</p></div>
          <div class="card"><span class="text-3xl">🐟</span><h3 class="mt-4 text-xl font-black">서대회·회무침류</h3><p class="mt-2 text-sm text-slate-400">새콤한 양념과 채소를 곁들이는 남해안식 생선 요리. 날음식 섭취가 어려운 방문자는 조리 메뉴를 선택하세요.</p></div>
