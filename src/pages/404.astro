---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="페이지를 찾을 수 없습니다 | 여수 낭만포차거리 안내" description="요청한 페이지를 찾을 수 없습니다." noindex={true}>
  <main id="main" class="container flex min-h-screen items-center py-20">
    <div class="max-w-2xl"><img src="/logo.svg" alt="여수 낭만포차거리 안내" class="h-16 w-auto"/><p class="mt-12 text-sm font-black tracking-[.2em] text-[#43d0d2]">404</p><h1 class="mt-2 text-5xl font-black tracking-[-.05em] md:text-7xl">길을 잠시<br/>벗어났습니다.</h1><p class="mt-6 text-slate-400">요청한 페이지를 찾을 수 없습니다. 여수 낭만포차거리 여행 안내 첫 화면으로 돌아가 주세요.</p><a href="/" class="mt-8 inline-block rounded-full bg-[#ff655b] px-6 py-3 font-black text-[#071522]">첫 화면으로 돌아가기</a></div>
  </main>
</BaseLayout>
